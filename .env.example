# Injected by `neon link` / `neon env pull` (don't edit by hand)
NEON_BRANCH="main"
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
NEON_AI_GATEWAY_TOKEN=""
NEON_AI_GATEWAY_BASE_URL=""

# Yours
EXA_API_KEY=""
SLACK_BOT_TOKEN=""        # xoxb-... from the Slack app's OAuth page
SLACK_SIGNING_SECRET=""   # Slack app > Basic Information
SLACK_CHANNEL_ID=""       # C0123... (channel > View details > bottom)
BRIEF_SECRET=""           # any long random string; protects POST /brief

# Optional: YouTube lane. Without these, Signal runs on Exa only.
YT_CLIENT_ID=""
YT_CLIENT_SECRET=""
YT_REFRESH_TOKEN=""
